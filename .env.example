# Copy to .env and fill in.
# Gemini API key from https://aistudio.google.com/apikey (free tier works)
GEMINI_API_KEY=your_key_here

# Only needed for --repo mode and the MCP summarize_failed_run tool.
# Fine-grained token on your test repo: Actions (read), Contents (read), Pull requests (write)
GITHUB_TOKEN=your_token_here

# Optional overrides
# TRIAGE_MODEL=gemma-4-26b-a4b-it
# FIX_MODEL=gemini-3.8-flash
